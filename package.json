{
  "name": "deneyap-blok-ide",
  "version": "1.0.0",
  "description": "Windows üzerinde tamamen offline çalışan, Deneyap Kart için Blok Tabanlı Programlama IDE'si",
  "main": "dist-electron/main.js",
  "author": "Deneyap Blok IDE",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --dir",
    "setup-toolchain": "powershell -ExecutionPolicy Bypass -File scripts/setup-toolchain.ps1"
  },
  "dependencies": {
    "blockly": "^11.2.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.deneyapkart.blokide",
    "productName": "Deneyap Blok IDE",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "toolchain",
        "to": "toolchain",
        "filter": [
          "!staging/**"
        ]
      }
    ]
  }
}
